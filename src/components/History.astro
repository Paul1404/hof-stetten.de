---
import { HISTORY, POPULATION } from "../data/site";
import SourceRef from "./SourceRef.astro";

const peak = Math.max(...POPULATION.map((entry) => entry.people));
---
<section id="geschichte" class="band scroll-mt-20 bg-[color:var(--color-paper-deep)]">
  <div class="shell">
    <div class="marginal band-head">
      <p class="t-label">Chronik</p>
      <div>
        <h2 class="t-title">Aus der Chronik</h2>
      </div>
    </div>

    <ol role="list" class="mt-12 border-t border-[color:var(--color-line)] sm:mt-16">
      {HISTORY.map((entry) => (
        <li class="marginal border-b border-[color:var(--color-line)] py-7">
          <p class="t-figure text-[2rem] leading-none lg:pt-1">{entry.year}</p>
          <div>
            <h3 class="t-heading">{entry.title}</h3>
            <p class="t-body mt-2.5 text-[color:var(--color-ink-soft)]">{entry.text}</p>
            <SourceRef id={entry.sourceId} class="mt-3.5" />
          </div>
        </li>
      ))}
    </ol>

    <section class="marginal mt-16 border-t border-[color:var(--color-line)] pt-6 sm:mt-20" aria-labelledby="einwohner-heading">
      <p class="t-label lg:pt-2">Einwohner</p>
      <div>
        <h3 id="einwohner-heading" class="t-title">Einwohner seit 1871</h3>
        <p class="t-note mt-4 text-[color:var(--color-ink-soft)]">Die Reihe zählt den Gemeindeteil Hofstetten. Die Zahl von 1870 in der Chronik umfasst dagegen zusätzlich Bühl.</p>
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2"><SourceRef id="einwohner-historisch" /><SourceRef id="einwohner-2021" label="Stand 2021" /></div>

        <ol role="list" class="mt-9 max-w-2xl" aria-label="Historische Einwohnerzahlen">
          {POPULATION.map((entry) => (
            <li class="grid grid-cols-[2.75rem_1fr_2.5rem] items-center gap-4 border-t border-[color:var(--color-line-faint)] py-3">
              <span class="t-figure text-[0.9375rem] text-[color:var(--color-muted)]">{entry.year}</span>
              <span class="h-[3px] bg-[color:var(--color-line)]" aria-hidden="true"><span class="population-bar block h-full bg-[color:var(--color-forest)]" style={`--bar-width:${Math.round((entry.people / peak) * 100)}%`}></span></span>
              <span class="t-figure text-right text-[1.125rem]">{entry.people}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</section>
