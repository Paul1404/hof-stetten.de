---
import { Picture } from "astro:assets";
import portal from "../assets/images/st-anna-portal.jpg";
import statue from "../assets/images/heilige-familie.jpg";
import PhotoCredit from "./PhotoCredit.astro";
---
<section id="st-anna" class="band scroll-mt-20">
  <div class="shell">
    <div class="marginal band-head">
      <p class="t-label">St. Anna</p>
      <div>
        <h2 class="t-title">Die Kapelle in der Dorfmitte</h2>
        <div class="mt-5 max-w-xl space-y-4 text-[color:var(--color-ink-soft)]">
          <p class="t-body">Die katholische Kapelle St. Anna steht in der Dorfmitte. Der spätbarocke Saalbau trägt ein Satteldach, darüber sitzt ein achteckiger, schiefergedeckter Dachreiter mit Zwiebelhaube.</p>
          <p class="t-body">Über dem Portal versammeln sich die Vierzehn Nothelfer in einem Sandsteinrelief, das die Denkmalliste auf 1751 datiert. Die Kapelle ist unter der Nummer D-6-74-164-112 geschützt.</p>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-10 sm:mt-16 lg:grid-cols-12 lg:gap-8">
      <figure class="lg:col-span-5">
        <div class="photo aspect-[4/5]">
          <Picture src={portal} alt="Das Sandsteinportal von St. Anna mit der Jahreszahl 1744 und dem Relief der Vierzehn Nothelfer" widths={[480, 720, 960]} sizes="(min-width: 1024px) 38vw, 92vw" formats={["avif", "webp"]} quality={75} />
        </div>
        <figcaption class="mt-3">
          <p class="t-note text-[color:var(--color-ink-soft)]">Das Sandsteinportal trägt die Jahreszahl 1744.</p>
          <PhotoCredit class="mt-1" author="Stephan van Helden" href="https://commons.wikimedia.org/wiki/File:D-6-74-164-112_Kapelle_St_Anna_Hofstetten,_Portal.jpg" />
        </figcaption>
      </figure>

      <figure class="lg:col-span-6 lg:col-start-7 lg:mt-20">
        <div class="photo aspect-[4/5]">
          <Picture src={statue} alt="Sandsteinskulptur der Heiligen Familie vor St. Anna" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 46vw, 92vw" formats={["avif", "webp"]} quality={74} />
        </div>
        <figcaption class="mt-3">
          <p class="t-note text-[color:var(--color-ink-soft)]">Seit 2010 steht die Heilige Familie vor der Kapelle.</p>
          <PhotoCredit class="mt-1" author="Stephan van Helden" href="https://commons.wikimedia.org/wiki/File:Statue_der_Heiligen_Familie_vor_der_Kirche_St_Anna_in_Hofstetten.jpg" />
        </figcaption>
      </figure>
    </div>
  </div>
</section>
