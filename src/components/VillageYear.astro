---
import { VILLAGE_YEAR } from "../data/site";
import SourceRef from "./SourceRef.astro";
---
<section class="band-tight bg-[color:var(--color-paper-deep)]" aria-labelledby="dorfjahr-heading">
  <div class="shell">
    <div class="marginal band-head">
      <p class="t-label">Dorfjahr</p>
      <div>
        <h2 id="dorfjahr-heading" class="t-title">Was jedes Jahr wiederkehrt</h2>
        <p class="t-note mt-4 text-[color:var(--color-ink-soft)]">Maibaum, Wallfahrt, Brunnenfest und Annatag gehören zum wiederkehrenden Dorfjahr. Wann sie jeweils stattfinden, geben die örtlichen Vereine bekannt.</p>
        <SourceRef id="stadt-hofstetten" class="mt-3.5" />
      </div>
    </div>

    <ol role="list" class="mt-10 grid gap-x-8 gap-y-7 sm:mt-12 sm:grid-cols-2 lg:grid-cols-4">
      {VILLAGE_YEAR.map((entry) => (
        <li class="border-t border-[color:var(--color-line)] pt-5">
          <p class="t-label">{entry.date}</p>
          <h3 class="t-heading mt-2.5">{entry.title}</h3>
          <p class="t-note mt-1.5 text-[color:var(--color-ink-soft)]">{entry.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
