<header class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-[color:var(--color-forest)]/92 text-[color:var(--color-paper)] backdrop-blur-md">
  <nav class="page-shell flex h-16 items-center justify-between" aria-label="Hauptnavigation">
    <a href="/" class="flex min-h-11 items-center gap-3" aria-label="Hofstetten, Startseite">
      <span class="grid size-8 place-items-center rounded-full border border-[color:var(--color-brass-light)]/60 font-serif text-lg italic text-[color:var(--color-brass-light)]"><span class="leading-none">H</span></span>
      <span class="text-[13px] font-semibold tracking-[0.12em] uppercase">Hofstetten</span>
    </a>
    <div class="hidden items-center gap-7 text-[13px] tracking-[0.06em] lg:flex">
      <a class="link-line inline-flex min-h-11 items-center" href="/#geschichte">Geschichte</a>
      <a class="link-line inline-flex min-h-11 items-center" href="/#st-anna">St. Anna</a>
      <a class="link-line inline-flex min-h-11 items-center" href="/#entdecken">Landschaft</a>
      <a class="link-line inline-flex min-h-11 items-center" href="/#dorfleben">Dorfleben</a>
      <a class="link-line inline-flex min-h-11 items-center" href="/quellen">Quellen</a>
    </div>
    <button id="mobile-menu-open" type="button" class="inline-flex min-h-11 min-w-11 items-center justify-center text-[12px] tracking-[0.12em] uppercase lg:hidden" aria-controls="mobile-nav" aria-expanded="false">Menü</button>
  </nav>
</header>

<noscript>
  <style>#mobile-menu-open { display: none; }</style>
  <details class="fixed top-2.5 right-2.5 z-50 lg:hidden">
    <summary class="inline-flex min-h-11 cursor-pointer list-none items-center px-2 text-[12px] tracking-[0.12em] text-[color:var(--color-paper)] uppercase">Menü</summary>
    <nav class="fixed inset-x-0 top-16 grid gap-4 bg-[color:var(--color-forest)] px-6 py-6 font-serif text-3xl text-[color:var(--color-paper)] shadow-xl" aria-label="Mobile Navigation ohne JavaScript">
      <a href="/#geschichte">Geschichte</a>
      <a href="/#st-anna">St. Anna</a>
      <a href="/#entdecken">Landschaft</a>
      <a href="/#dorfleben">Dorfleben</a>
      <a href="/quellen">Quellen</a>
    </nav>
  </details>
</noscript>

<nav id="mobile-nav" class="fixed inset-0 z-50 overflow-y-auto overscroll-contain bg-[color:var(--color-forest)] px-6 pt-[max(1.25rem,env(safe-area-inset-top))] pb-[max(1.25rem,env(safe-area-inset-bottom))] text-[color:var(--color-paper)] lg:hidden" aria-label="Mobile Navigation" hidden>
  <div class="flex justify-end"><button id="mobile-menu-close" type="button" class="inline-flex min-h-11 items-center justify-center px-2 text-sm tracking-widest uppercase">Schließen</button></div>
  <div class="mt-10 grid gap-6 font-serif text-4xl sm:mt-20 sm:text-5xl">
    <a class="py-1" href="/#geschichte">Geschichte</a>
    <a class="py-1" href="/#st-anna">St. Anna</a>
    <a class="py-1" href="/#entdecken">Landschaft</a>
    <a class="py-1" href="/#dorfleben">Dorfleben</a>
    <a class="py-1" href="/quellen">Quellen</a>
  </div>
</nav>

<script>
  const openButton = document.querySelector<HTMLButtonElement>("#mobile-menu-open");
  const closeButton = document.querySelector<HTMLButtonElement>("#mobile-menu-close");
  const mobileNav = document.querySelector<HTMLElement>("#mobile-nav");
  const pageContent = document.querySelectorAll<HTMLElement>("header, main, footer");

  function setMenuOpen(isOpen: boolean) {
    if (!openButton || !closeButton || !mobileNav) return;
    mobileNav.hidden = !isOpen;
    openButton.setAttribute("aria-expanded", String(isOpen));
    document.documentElement.classList.toggle("menu-open", isOpen);
    pageContent.forEach((element) => { element.inert = isOpen; });
    if (isOpen) closeButton.focus();
    else if (openButton.offsetParent !== null) openButton.focus();
  }

  openButton?.addEventListener("click", () => setMenuOpen(true));
  closeButton?.addEventListener("click", () => setMenuOpen(false));
  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches && openButton?.getAttribute("aria-expanded") === "true") setMenuOpen(false);
  });
  mobileNav?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      setMenuOpen(false);
      return;
    }
    if (event.key !== "Tab") return;
    const controls = [...mobileNav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
    if (controls.length === 0) return;
    const first = controls[0];
    const last = controls.at(-1);
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
</script>
