---
import { Picture } from "astro:assets";
import hero from "../assets/images/hofstetten-luftbild.jpg";
import PhotoCredit from "./PhotoCredit.astro";
import VillageMark from "./VillageMark.astro";
---
<section>
  <div class="shell pt-12 pb-10 sm:pt-16 sm:pb-14">
    <VillageMark class="w-24 text-[color:var(--color-rust)]" />
    <h1 class="t-display mt-6 whitespace-nowrap">Hofstetten</h1>
    <p class="t-lede mt-8 text-[color:var(--color-ink-soft)]">
      Ein Kirchdorf in den Haßbergen, auf halbem Weg zwischen Ebern und Haßfurt.
      Seit 1972 gehört es zu Königsberg i.Bay.
    </p>
  </div>

  <figure>
    <!-- 16:9 at every width: the village is a line, and cropping the frame
         narrower would cut the ends off the Dorfstraße. -->
    <div class="photo aspect-[16/9] border-y border-[color:var(--color-line)]">
      <Picture src={hero} alt="Luftbild von Hofstetten: die Höfe stehen in zwei Reihen entlang der geraden Dorfstraße, ringsum Felder, im Osten Wald" widths={[640, 960, 1280, 1600, 1920, 2500]} sizes="100vw" formats={["avif", "webp"]} quality={78} loading="eager" fetchpriority="high" />
    </div>
    <div class="shell mt-2 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <PhotoCredit label="Luftbild" author="Bayerische Vermessungsverwaltung" license="CC BY 4.0" href="https://geodaten.bayern.de/opengeodata/OpenDataDetail.html?pn=dop20" />
      <p class="t-label">398 m über NN · 138 Einwohner</p>
    </div>
  </figure>
</section>
