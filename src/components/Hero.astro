---
import { Picture } from "astro:assets";
import hero from "../assets/images/st-anna.jpg";
import PhotoCredit from "./PhotoCredit.astro";
import VillageMark from "./VillageMark.astro";
---
<section>
  <div class="shell pt-12 pb-10 sm:pt-16 sm:pb-14">
    <VillageMark class="w-24 text-[color:var(--color-rust)]" />
    <h1 class="t-display mt-6 whitespace-nowrap">Hofstetten</h1>
    <p class="t-lede mt-8 text-[color:var(--color-ink-soft)]">
      Ein Kirchdorf in den Haßbergen, auf halbem Weg zwischen Ebern und Haßfurt.
      Seit 1972 gehört es zu Königsberg i.Bay.
    </p>
  </div>

  <figure>
    <!-- The source photo is 3:2, so the crop stays near it: at 21:9 the chapel
         lost its walls and read as a strip of roofline. -->
    <div class="photo aspect-[4/3] border-y border-[color:var(--color-line)] sm:aspect-[3/2] lg:aspect-[16/9]">
      <Picture src={hero} alt="Die Kapelle St. Anna in Hofstetten mit ihrem Dachreiter" widths={[640, 960, 1280, 1600, 1920]} sizes="100vw" formats={["avif", "webp"]} quality={76} loading="eager" fetchpriority="high" class="object-[50%_44%]" />
    </div>
    <div class="shell mt-2 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <PhotoCredit author="Tilman2007" href="https://commons.wikimedia.org/wiki/File:Hofstetten_27_K%C3%B6nigsberg_in_Bayern_20201129_001.jpg" />
      <p class="t-label">398 m über NN · 138 Einwohner</p>
    </div>
  </figure>
</section>
