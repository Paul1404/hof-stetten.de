---
import { Picture } from "astro:assets";
import hero from "../assets/images/hofstetten-luftbild-herbst.webp";
import PhotoCredit from "./PhotoCredit.astro";
---
<section class="hero">
  <div class="hero-image">
    <Picture
      src={hero}
      alt=""
      aria-hidden="true"
      widths={[640, 960, 1280, 1600, 1920, 2500]}
      sizes="100vw"
      formats={["avif", "webp"]}
      quality={82}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-credit">
      <PhotoCredit
        label="Quelle"
        author="Stadt Königsberg i.Bay."
        license=""
        href="https://koenigsberg.de/home-rathaus-gemeinde/stadt-gemeinde/stadt-und-stadtteile/hofstetten-mit-buehl/"
        dark
        class="!text-white/65 hover:!text-white"
      />
    </div>
  </div>

  <div class="shell hero-title-wrap">
    <div class="hero-title-panel">
      <h1 class="hero-title">Hofstetten</h1>
      <p class="hero-subtitle">Ein Kirchdorf in den Haßbergen, zwischen Ebern und Haßfurt.</p>
    </div>
  </div>
</section>
