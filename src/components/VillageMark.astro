---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---
<!-- Hofstetten in plan: the Dorfstraße, with the houses standing on both sides of it. -->
<svg class={className} viewBox="0 0 96 22" fill="none" aria-hidden="true">
  <g fill="currentColor">
    <rect x="12" y="4" width="11" height="6" /><rect x="28" y="2" width="9" height="8" />
    <rect x="43" y="5" width="12" height="5" /><rect x="70" y="3" width="12" height="7" />
  </g>
  <rect x="1" y="10" width="94" height="1.6" fill="currentColor" />
  <g fill="currentColor" opacity=".62">
    <rect x="6" y="12" width="13" height="6" /><rect x="30" y="12" width="12" height="7" />
    <rect x="51" y="12" width="16" height="5" /><rect x="74" y="12" width="13" height="7" />
  </g>
</svg>
