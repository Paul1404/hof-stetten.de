---
import SourceRef from "./SourceRef.astro";

const FACTS = [
  { term: "Stadt", value: "Königsberg i.Bay." },
  { term: "Landkreis", value: "Haßberge" },
  { term: "Postleitzahl", value: "97486" },
  { term: "Vorwahl", value: "09525" },
];
---
<section class="band">
  <div class="shell">
    <div class="marginal band-head">
      <p class="t-label">Der Ort</p>
      <h2 class="t-title">Ein Straßendorf</h2>
    </div>

    <div class="marginal mt-10 sm:mt-12">
      <div class="lg:pt-1">
        <p class="t-label">Ortsname</p>
        <p class="mt-2 font-serif text-[1.35rem] leading-snug font-light italic text-[color:var(--color-ink-soft)]">bei den Hofstätten</p>
      </div>
      <div class="grid gap-x-12 gap-y-6 text-[color:var(--color-ink-soft)] sm:grid-cols-2">
        <p class="t-body">Die Häuser stehen entlang der Dorfstraße. In der Mitte liegen die Kapelle St. Anna und die ehemalige Schule in Hofstetten 31, die heute als Vereinsheim genutzt wird.</p>
        <p class="t-body">Zum 1. Januar 2021 waren 138 Einwohner gemeldet. Hofstetten und der Weiler Bühl gehören kirchlich zu Jesserndorf. Im Ort sind unter anderem Blaskapelle, Feuerwehr und Jagdgenossenschaft aktiv.</p>
      </div>
    </div>

    <dl class="mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-[color:var(--color-line)] pt-6 sm:grid-cols-4">
      {FACTS.map((fact) => (
        <div>
          <dt class="t-label">{fact.term}</dt>
          <dd class="t-figure mt-1.5 text-[1.15rem]">{fact.value}</dd>
        </div>
      ))}
    </dl>

    <div class="marginal mt-16 border-t border-[color:var(--color-line)] pt-6 sm:mt-20">
      <p class="t-label lg:pt-2">Visitationsbericht 1870</p>
      <div>
        <p class="t-lede max-w-2xl text-[color:var(--color-ink)]">Der amtliche Bericht beschreibt Hofstetten als Ort mit „einer einzigen Hauptstraße“.</p>
        <SourceRef id="visitation-1870" label="Zum Bericht" class="mt-4" />
      </div>
    </div>
  </div>
</section>
