---
import { Picture } from "astro:assets";
import villageCrest from "../assets/images/dorfwappen-hofstetten.webp";
import SourceRef from "./SourceRef.astro";

const REGISTER = [
  {
    figure: "1965",
    qualifier: null,
    title: "Blaskapelle",
    text: "Die 1965 gegründete Blaskapelle spielt bei Gottesdiensten, Festen und Konzerten in Hofstetten und der Umgebung. 2025 feierte der Verein sein 60-jähriges Bestehen.",
    link: { href: "https://www.blaskapelle-hofstetten.de/", label: "blaskapelle-hofstetten.de" },
    sources: [],
  },
  {
    figure: "1883",
    qualifier: "um",
    title: "Freiwillige Feuerwehr",
    text: "Die Stadt datiert die Gründung der Hofstettener Feuerwehr auf etwa 1883. Der Feuerwehr-Förderverein besteht seit 1983.",
    link: null,
    sources: [{ id: "stadt-hofstetten", label: "Quelle" }],
  },
  {
    figure: "31",
    qualifier: "Haus",
    title: "Die alte Schule",
    text: "Noch 1975/76 wurden hier Klassen der Königsberger Schule unterrichtet. Heute dient das Haus als Vereinsheim, Wahllokal und Versammlungsort. Der Spielplatz liegt direkt daneben.",
    link: null,
    sources: [
      { id: "schulgeschichte", label: "Schulgeschichte" },
      { id: "spielplatz", label: "Spielplatz" },
    ],
  },
  {
    figure: "2014",
    qualifier: null,
    title: "Das Dorfwappen",
    text: "Seine Teilung steht für Dorfstraße und Häuserzeilen. Beil und Sonnenblume verweisen auf Waldarbeit und die Kirchenpatronin St. Anna.",
    link: null,
    sources: [{ id: "stadt-hofstetten", label: "Quelle" }],
  },
];
---
<section id="dorfleben" class="band scroll-mt-20">
  <div class="shell">
    <div class="marginal band-head">
      <p class="t-label">Dorfleben</p>
      <h2 class="t-title">Was den Ort zusammenhält</h2>
    </div>

    <div class="mt-12 border-t border-[color:var(--color-line)] sm:mt-16">
      {REGISTER.map((entry) => (
        <article class="marginal border-b border-[color:var(--color-line)] py-7">
          <p class="lg:pt-1">
            {entry.qualifier && <span class="t-label mr-1.5 align-[0.35em]">{entry.qualifier}</span>}
            <span class="t-figure text-[2rem] leading-none">{entry.figure}</span>
          </p>
          <div>
            <h3 class="t-heading">{entry.title}</h3>
            <div class:list={[entry.title === "Das Dorfwappen" && "mt-3 grid gap-6 sm:grid-cols-[minmax(0,1fr)_10rem] sm:items-start"]}>
              {entry.title === "Das Dorfwappen" && (
                <figure class="order-first sm:order-last sm:row-span-2">
                  <div class="overflow-hidden border border-[color:var(--color-line)] bg-white p-2">
                    <Picture
                      src={villageCrest}
                      alt="Das Hofstettener Dorfwappen mit Sonnenblume, Beil und geteilter Fläche"
                      widths={[240, 360]}
                      sizes="(min-width: 640px) 10rem, 12rem"
                      formats={["avif", "webp"]}
                      quality={84}
                      class="mx-auto h-auto w-full max-w-48"
                    />
                  </div>
                </figure>
              )}
              <div>
                <p class:list={["t-body text-[color:var(--color-ink-soft)]", entry.title !== "Das Dorfwappen" && "mt-2.5"]}>{entry.text}</p>
                {entry.link && (
                  <a class="link-line mt-3.5 inline-flex min-h-8 items-center text-sm text-[color:var(--color-rust)]" href={entry.link.href} rel="external">{entry.link.label}</a>
                )}
                {entry.sources.length > 0 && (
                  <div class="mt-3.5 flex flex-wrap gap-x-5 gap-y-2">
                    {entry.sources.map((source) => <SourceRef id={source.id} label={source.label} />)}
                  </div>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
