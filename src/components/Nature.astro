---
import { Picture } from "astro:assets";
import forest from "../assets/images/moenchsberg.jpg";
import stream from "../assets/images/ebelsbach.jpg";
import PhotoCredit from "./PhotoCredit.astro";
---
<section id="entdecken" class="overflow-hidden bg-[color:var(--color-forest)] py-24 text-[color:var(--color-paper)] sm:py-28">
  <div class="page-shell">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-end">
      <div>
        <p class="eyebrow !text-[color:var(--color-brass-light)]">Rund um Hofstetten</p>
        <h2 class="section-title mt-8 !text-[color:var(--color-paper)]">Ebelsbach und Mönchsberg.</h2>
      </div>
      <p class="max-w-lg justify-self-end text-base leading-7 text-white/70">Der Ebelsbach entspringt bei Hofstetten und fließt auf rund 16 Kilometern zum Main. Am Mönchsberg führt ein Waldweg zur sogenannten Wolfsgrube. Der Visitationsbericht von 1870 nennt die hohe Lage der Flur und die geringe Ertragsfähigkeit der Felder. <a class="source-ref source-ref-dark" href="/quellen#ebelsbach-lfu">Quelle</a></p>
    </div>

    <div class="mt-20 grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-end">
      <figure>
        <div class="photo-frame aspect-[3/4] rounded-sm">
          <Picture src={forest} alt="Waldweg zur Wolfsgrube am Mönchsberg bei Hofstetten" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 37vw, 92vw" formats={["avif", "webp"]} quality={72} />
        </div>
        <PhotoCredit author="Stephan van Helden" href="https://commons.wikimedia.org/wiki/File:Weg_zur_Wolfsgrube_am_M%C3%B6nchsberg.jpg" dark />
      </figure>
      <figure class="lg:pb-16">
        <div class="photo-frame aspect-[16/10]">
          <Picture src={stream} alt="Der junge Ebelsbach in der offenen Landschaft nordwestlich von Hofstetten" widths={[720, 1080, 1440]} sizes="(min-width: 1024px) 53vw, 92vw" formats={["avif", "webp"]} quality={72} />
        </div>
        <PhotoCredit author="Stephan van Helden" href="https://commons.wikimedia.org/wiki/File:Der_Ebelsbach_nordwestlich_von_Hofstetten_(3).jpg" dark />
        <figcaption class="mt-5 max-w-md text-sm leading-6 text-white/55">Der Ebelsbach nordwestlich von Hofstetten.</figcaption>
      </figure>
    </div>
  </div>
</section>
