---
import { Picture } from "astro:assets";
import forest from "../assets/images/moenchsberg.jpg";
import stream from "../assets/images/ebelsbach.jpg";
import PhotoCredit from "./PhotoCredit.astro";
import SourceRef from "./SourceRef.astro";
---
<section id="landschaft" class="band scroll-mt-20 bg-[color:var(--color-forest)] text-[color:var(--color-paper)]">
  <div class="shell">
    <div class="marginal border-t border-white/20 pt-6">
      <p class="t-label !text-[color:var(--color-brass)]">Landschaft</p>
      <div>
        <h2 class="t-title">Ebelsbach und Mönchsberg</h2>
        <p class="t-body mt-5 text-white/70">Der Ebelsbach entspringt bei Hofstetten und fließt auf rund 16 Kilometern zum Main. Am Mönchsberg führt ein Waldweg zur sogenannten Wolfsgrube. Der Visitationsbericht von 1870 nennt die hohe Lage der Flur und die geringe Ertragsfähigkeit der Felder.</p>
        <SourceRef id="ebelsbach-lfu" dark class="mt-3.5" />
      </div>
    </div>

    <div class="mt-12 grid gap-10 sm:mt-16 lg:grid-cols-12 lg:gap-8">
      <figure class="lg:col-span-4">
        <div class="photo aspect-[3/4] bg-white/5">
          <Picture src={forest} alt="Waldweg zur Wolfsgrube am Mönchsberg bei Hofstetten" widths={[480, 720, 960]} sizes="(min-width: 1024px) 30vw, 92vw" formats={["avif", "webp"]} quality={72} />
        </div>
        <figcaption class="mt-3">
          <p class="t-note text-white/55">Der Waldweg zur Wolfsgrube am Mönchsberg.</p>
          <PhotoCredit class="mt-1" author="Stephan van Helden" href="https://commons.wikimedia.org/wiki/File:Weg_zur_Wolfsgrube_am_M%C3%B6nchsberg.jpg" dark />
        </figcaption>
      </figure>
      <figure class="lg:col-span-7 lg:col-start-6 lg:mt-24">
        <div class="photo aspect-[16/10] bg-white/5">
          <Picture src={stream} alt="Der junge Ebelsbach in der offenen Landschaft nordwestlich von Hofstetten" widths={[720, 1080, 1440]} sizes="(min-width: 1024px) 54vw, 92vw" formats={["avif", "webp"]} quality={72} />
        </div>
        <figcaption class="mt-3">
          <p class="t-note text-white/55">Der junge Ebelsbach nordwestlich von Hofstetten.</p>
          <PhotoCredit class="mt-1" author="Stephan van Helden" href="https://commons.wikimedia.org/wiki/File:Der_Ebelsbach_nordwestlich_von_Hofstetten_(3).jpg" dark />
        </figcaption>
      </figure>
    </div>
  </div>
</section>
