---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Introduction from "../components/Introduction.astro";
import History from "../components/History.astro";
import Chapel from "../components/Chapel.astro";
import Nature from "../components/Nature.astro";
import VillageLife from "../components/VillageLife.astro";
import VillageYear from "../components/VillageYear.astro";
import Footer from "../components/Footer.astro";
---
<Base>
  <Nav />
  <main id="hauptinhalt" tabindex="-1">
    <Hero />
    <Introduction />
    <History />
    <Chapel />
    <Nature />
    <VillageLife />
    <VillageYear />
  </main>
  <Footer />
</Base>
