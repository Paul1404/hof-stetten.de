---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import VillageMark from "../components/VillageMark.astro";
---
<Base title="Seite nicht gefunden. Hofstetten." description="Die angeforderte Seite wurde nicht gefunden." noindex>
  <Nav />
  <main id="hauptinhalt" tabindex="-1" class="grid min-h-[70svh] place-items-center px-6 py-20">
    <div class="max-w-md">
      <VillageMark class="w-24 text-[color:var(--color-line)]" />
      <h1 class="t-title mt-6">Seite nicht gefunden</h1>
      <p class="t-body mt-4 text-[color:var(--color-ink-soft)]">Diese Adresse führt ins Feld. Zurück zum Ortsporträt geht es über den Anfang.</p>
      <a class="link-line mt-6 inline-flex min-h-11 items-center text-[color:var(--color-rust)]" href="/">Zurück nach Hofstetten</a>
    </div>
  </main>
  <Footer />
</Base>
