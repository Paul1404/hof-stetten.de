---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { PHOTO_CREDITS, SOURCES } from "../data/site";
---
<Base title="Quellen und Bildnachweise. Hofstetten." description="Quellen, Recherchegrundlagen und Bildnachweise für das Ortsporträt Hofstetten.">
  <Nav />
  <main id="hauptinhalt" tabindex="-1" class="band">
    <div class="shell">
      <div class="marginal band-head">
        <p class="t-label">Dokumentation</p>
        <div>
          <h1 class="t-title">Quellen und Bildnachweise</h1>
          <p class="t-body mt-5 text-[color:var(--color-ink-soft)]">Die historischen Angaben auf dieser Website sind mit Quellen belegt. Die nur indirekt zugeordnete Nennung von 1135 ist im Text entsprechend gekennzeichnet.</p>
        </div>
      </div>

      <section class="mt-14 sm:mt-20">
        <h2 class="t-label">Recherchegrundlagen</h2>
        <ol role="list" class="mt-4 border-t border-[color:var(--color-line)]">
          {SOURCES.map((source, index) => (
            <li id={source.id} class="marginal scroll-mt-20 border-b border-[color:var(--color-line)] py-6">
              <span class="t-figure text-[1.25rem] text-[color:var(--color-muted)] lg:pt-0.5">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="t-heading">{"href" in source ? <a class="link-line" href={source.href} rel="external">{source.title}</a> : source.title}</h3>
                <p class="t-note mt-2 max-w-2xl text-[color:var(--color-ink-soft)]">{source.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-14 sm:mt-20">
        <h2 class="t-label">Fotografien</h2>
        <p class="t-note mt-4 max-w-2xl text-[color:var(--color-ink-soft)]">Die Fotografien stammen aus Wikimedia Commons. Das Luftbild wurde von der Stadt Königsberg i.Bay. veröffentlicht. Alle Aufnahmen wurden für die Webausgabe zugeschnitten, skaliert und komprimiert; die jeweilige Rechteangabe steht direkt beim Bildnachweis.</p>
        <ol role="list" class="mt-6 grid border-t border-[color:var(--color-line)] md:hidden">
          {PHOTO_CREDITS.map((photo) => (
            <li class="grid gap-1.5 border-b border-[color:var(--color-line)] py-5">
              <p class="t-heading">{photo.title}</p>
              <p class="t-note text-[color:var(--color-ink-soft)]">{photo.author}, {"licenseUrl" in photo ? <a class="link-line" href={photo.licenseUrl}>{photo.license}</a> : photo.license}</p>
              <a class="source-ref mt-1" href={photo.source}>Original bei {photo.sourceLabel}</a>
            </li>
          ))}
        </ol>
        <div class="mt-6 hidden overflow-x-auto md:block" role="region" aria-label="Bildnachweise" tabindex="0">
          <table class="w-full min-w-[42rem] border-collapse text-left text-sm">
            <thead><tr class="border-y border-[color:var(--color-line)]"><th scope="col" class="t-label py-3 pr-6 font-semibold">Motiv</th><th scope="col" class="t-label py-3 pr-6 font-semibold">Urheber</th><th scope="col" class="t-label py-3 pr-6 font-semibold">Lizenz</th><th scope="col" class="t-label py-3 font-semibold">Original</th></tr></thead>
            <tbody>
              {PHOTO_CREDITS.map((photo) => (
                <tr class="border-b border-[color:var(--color-line)]"><td class="py-4 pr-6 font-serif text-[1.0625rem]">{photo.title}</td><td class="py-4 pr-6 text-[color:var(--color-ink-soft)]">{photo.author}</td><td class="py-4 pr-6">{"licenseUrl" in photo ? <a class="link-line text-[color:var(--color-ink-soft)]" href={photo.licenseUrl}>{photo.license}</a> : <span class="text-[color:var(--color-ink-soft)]">{photo.license}</span>}</td><td class="py-4"><a class="link-line text-[color:var(--color-rust)]" href={photo.source}>{photo.sourceLabel}</a></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>
