---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Base title="Impressum. Hofstetten." description="Impressum für hof-stetten.de.">
  <Nav />
  <main id="hauptinhalt" tabindex="-1" class="band">
    <div class="shell">
      <article class="marginal band-head">
        <p class="t-label">Rechtliches</p>
        <div>
          <h1 class="t-title">Impressum</h1>
          <div class="mt-8 space-y-8 text-[color:var(--color-ink-soft)]">
            <section><h2 class="t-label">Angaben gemäß § 5 DDG</h2><p class="t-body mt-2">Paul Dresch<br />Schweinfurter Weg 6<br />97508 Untereuerheim</p></section>
            <section><h2 class="t-label">Kontakt</h2><p class="t-body mt-2">E-Mail: <a class="link-line text-[color:var(--color-rust)]" href="mailto:paul.dresch@untereuerheim.com">paul.dresch@untereuerheim.com</a></p></section>
            <section><h2 class="t-label">Inhaltlicher Hinweis</h2><p class="t-body mt-2">hof-stetten.de ist ein unabhängiges, redaktionelles Ortsporträt. Die Website ist kein offizielles Angebot der Stadt Königsberg i.Bay., des Landkreises Haßberge oder der genannten Vereine und Einrichtungen.</p></section>
            <section><h2 class="t-label">Haftung für Links</h2><p class="t-body mt-2">Diese Website enthält Links zu externen Angeboten. Für deren Inhalte sind ausschließlich die jeweiligen Betreiber verantwortlich.</p></section>
          </div>
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Base>
