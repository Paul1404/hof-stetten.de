---
import "../styles/global.css";
import { SITE } from "../data/site";
import newsreader from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import manrope from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = "Hofstetten. Ein Kirchdorf in den Haßbergen.",
  description = SITE.description,
  image = "/og.jpg",
  imageAlt = "Die Kapelle St. Anna in Hofstetten",
  noindex = false,
} = Astro.props;

const origin = Astro.site ?? new URL("/", Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).toString();
const ogImage = new URL(image, origin).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("#website", origin).toString(),
      url: origin.toString(),
      name: SITE.name,
      inLanguage: "de-DE",
      description: SITE.description,
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "de-DE",
      isPartOf: { "@id": new URL("#website", origin).toString() },
      about: { "@id": new URL("#hofstetten", origin).toString() },
    },
    {
      "@type": "Place",
      "@id": new URL("#hofstetten", origin).toString(),
      name: "Hofstetten",
      description: SITE.description,
      url: origin.toString(),
      image: ogImage,
      geo: {
        "@type": "GeoCoordinates",
        latitude: SITE.latitude,
        longitude: SITE.longitude,
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Hofstetten",
        postalCode: "97486",
        addressRegion: "BY",
        addressCountry: "DE",
      },
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Königsberg i.Bay.",
      },
      sameAs: ["https://de.wikipedia.org/wiki/Hofstetten_(K%C3%B6nigsberg_in_Bayern)"],
    },
  ],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={newsreader} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#17372d" />
    <meta name="geo.region" content="DE-BY" />
    <meta name="geo.placename" content="Hofstetten, Königsberg i.Bay." />
    <meta name="geo.position" content={`${SITE.latitude};${SITE.longitude}`} />
    <meta name="ICBM" content={`${SITE.latitude}, ${SITE.longitude}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hofstetten" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#hauptinhalt">Zum Inhalt</a>
    <slot />
  </body>
</html>
